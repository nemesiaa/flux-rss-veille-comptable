// Programme: Actualites publiques - Configuration exemple Cloudflare Workers
// Date: 2026-10-23 - Auteur: nemesiaa
// Execution: remplacer l identifiant KV, puis npm run cloud:deploy.
// Produit: un Worker public et son declencheur de collecte planifiee.
{
  "name": "flux-rss-belgique",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": {"crons": ["*/10 * * * *"]},
  "observability": {"enabled": true},
  "kv_namespaces": [{"binding": "RSS_CACHE", "id": "REMPLACER_PAR_IDENTIFIANT_KV"}]
}
