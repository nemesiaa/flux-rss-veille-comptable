{
  "name": "actualites-publiques",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "refresh": "node --env-file-if-exists=.env src/refresh.js",
    "verify": "node src/verify.js",
    "cloud:login": "wrangler login",
    "cloud:deploy": "wrangler deploy",
    "cloud:check": "wrangler deploy --dry-run",
    "cloud:refresh": "node --env-file-if-exists=.env src/remote-refresh.js"
  },
  "dependencies": {
    "domutils": "^4.0.2",
    "entities": "^8.1.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.131.2"
  }
}
